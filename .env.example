# Copia este archivo a `.env` y ajusta los valores para tu entorno
# local — `.env` no se commitea (ver .gitignore).

# Backend por defecto de la capability `libredte.backend` — usado por
# `services.libredte_backend.get_backend()` y, como reserva, por
# cualquier tenant que active el plugin `libredte_lib_api` sin
# indicar su propio `base_url`/`api_token`. Sin definir,
# PLUGIN_LIBREDTE_BACKEND_API_URL apunta a https://core.libredte.cl/api y
# PLUGIN_LIBREDTE_BACKEND_API_TOKEN queda vacío (sin token).
#PLUGIN_LIBREDTE_BACKEND_API_URL=https://pro.libredte.cl/api
#PLUGIN_LIBREDTE_BACKEND_API_TOKEN=

# Cuenta de apigateway.cl por defecto de la capability `sii.backend`
# — usada, como reserva, por cualquier tenant que active el plugin
# `apigatewaycl` sin indicar su propio `base_url`/`api_token`. Sin
# definir, PLUGIN_APIGATEWAYCL_API_URL apunta a
# https://app.apigateway.cl (sin `/api/v2` — el cliente ya lo antepone
# internamente) y PLUGIN_APIGATEWAYCL_API_TOKEN queda vacío (sin token
# — sin uno propio ni global, `sii.backend` simplemente no está
# disponible).
#PLUGIN_APIGATEWAYCL_API_URL=
#PLUGIN_APIGATEWAYCL_API_TOKEN=

# Clave secreta de Django. Sin definir, se usa el valor inseguro
# generado por `startproject` (solo válido para desarrollo local).
# Generar una nueva con:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#SECRET_KEY=

# Key de cifrado en reposo para `apps.core.fields.EncryptedTextField`
# (ej. `Contribuyente.certificado_clave_privada`). Sin definir, se usa
# un valor de desarrollo (ver `config/settings.py`). Generar una nueva
# con:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#FIELD_ENCRYPTION_KEY=

# Modo debug de Django. Sin definir queda encendido (solo válido para
# desarrollo local); en producción, DEBUG=0. Con DEBUG=0 la app no
# arranca si SECRET_KEY o FIELD_ENCRYPTION_KEY siguen con su valor por
# defecto (es público): hay que definir ambas.
#DEBUG=0

# Dominios del sitio, separados por espacio (con puerto si no es el
# estándar, ej. `localhost:8080`). El primero es el que se usa en los
# enlaces absolutos que se arman fuera de un request (como el de
# descarga de los PDF de la emisión masiva, que va en un correo). Son
# también los únicos `Host` que la app acepta (ALLOWED_HOSTS, además de
# localhost/127.0.0.1/::1) y los orígenes de confianza para los POST
# (CSRF), junto con SITE_URL_SCHEMA. Sin definir, localhost:8000 y http
# (solo válido para desarrollo local).
#SITE_HOSTNAME=slim.example.com
#SITE_URL_SCHEMA=https

# Otros dominios o IP por los que se accede a la app, separados por
# espacio, solo sin puerto (ej. una IP de la red local). Se suman a los de
# SITE_HOSTNAME en ALLOWED_HOSTS. Sin definir, ninguno.
#SITE_EXTRA_HOSTS=

# 1 cuando un proxy inverso (Caddy, Traefik, nginx) termina el TLS y
# reenvía X-Forwarded-Proto: Django lo usa para saber que la petición es
# HTTPS. Activarlo solo si el proxy es lo único que llega a la app (si no,
# un cliente podría falsear la cabecera). Sin definir, 0.
#SITE_BEHIND_PROXY=1

# Nivel de los logs (stdout): DEBUG, INFO, WARNING, ERROR. Sin definir,
# INFO.
#LOG_LEVEL=INFO

# Carpeta destino de `manage.py collectstatic` (CSS/JS/imágenes). En
# producción la sirve el servidor web, no la app. Sin definir,
# staticfiles/ dentro del proyecto.
#STATIC_ROOT=

# Carpeta de los archivos que suben los usuarios (ej. el logo del
# contribuyente). Es pública (se sirve en /media/) y debe conservarse
# entre despliegues y respaldarse. Sin definir, media/ dentro del
# proyecto.
#MEDIA_ROOT=

# Base de datos. Sin definir, sqlite (default de desarrollo). Para
# Postgres (producción — el driver ya viene instalado, solo definir):
#DB_ENGINE=postgresql
#DB_NAME=libredte_slim
#DB_USER=libredte_slim
#DB_PASSWORD=
#DB_HOST=localhost
#DB_PORT=5432

# Broker de Celery y caché de Django. Sin definir, Redis local.
#CELERY_BROKER_URL=redis://localhost:6379/0

# Correo SMTP. Sin EMAIL_HOST, los correos se imprimen en consola. Sin
# EMAIL_PORT, se deduce de SSL/TLS. Ejemplo con Gmail (exige una
# contraseña de aplicación: https://myaccount.google.com/apppasswords).
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=465
#EMAIL_USE_SSL=1
#EMAIL_USE_TLS=0
#EMAIL_HOST_USER=cuenta@gmail.com
#EMAIL_HOST_PASSWORD=
# Sin definir, se usa EMAIL_HOST_USER.
#DEFAULT_FROM_EMAIL=

# Emisión masiva: carpeta donde quedan los ZIP con los PDF que se
# descargan desde el enlace del correo. No se publica y tiene que ser la
# misma para el servidor web y el worker (en Docker, un volumen
# compartido). Sin definir, storage/emision_masiva/pdf dentro del
# proyecto.
#EMISION_MASIVA_PDF_DIR=
